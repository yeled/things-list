<div class="layout layout--top layout--col px--6 py--6">
  <div class="columns" data-overflow-cols="1" data-overflow-counter="true">
    <div class="column"> 
      {% if reg_todos != blank %}
        {{ regular_todos }}
      {% elsif total != blank %}
        {{ empty_state }}
      {% else %}
        {{ no_data-vert }}
      {% endif %}
    </div>
  </div>
</div>
<div class="title_bar">
  <img class="image image-stroke image-stroke--small" src="data:image/svg+xml;base64,{{ things_logo | base64_encode }}" alt="icon">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <div class="flex flex--row w--full flex--right">
    {% if total <= 10 %}
      {{ progress_dots }}
    {% elsif total <= 12 %}
      {{ progress_dots--small }}
    {% else %}
      {{ progress_bar }}
    {% endif %}
  </div>
</div>
