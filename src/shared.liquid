{%- capture apple_shortcut-img %}
<img class="shrink-0" alt="Apple Shortcut Link" style="width: 132px; image-rendering: pixelated;" src="data:image/png;base64," />
{% endcapture -%}

{%- capture regular_todos %}
<span class="label label--medium group-header" data-group-header="true"></span>
{% for todo in todos %}

<div class="item">
  <div class="meta"></div>
  <div class="content">
    <span class="title title--small font--regular"
      {% if trmnl.plugin_settings.custom_fields_values.lines_title | plus: 0 > 0 %}
        data-clamp="{{ trmnl.plugin_settings.custom_fields_values.lines_title }}"
      {% endif %}
      >{{ todo.title }}</span>
    {% if todo.description != blank and trmnl.plugin_settings.custom_fields_values.lines_description | plus: 0 != -1 %}
    <span class="description mt--0.5 mb--1" 
      {% if trmnl.plugin_settings.custom_fields_values.lines_description | plus: 0 > 0 %}
      data-clamp="{{ trmnl.plugin_settings.custom_fields_values.lines_description }}"
      {% endif %}
      >{{ todo.description }}
    </span>
    {% endif %}
    {% if todo.project != blank or todo.reminder != blank %} 
      <div class="flex flex--row">
        {% if todo.project != blank %}
        <span class="label label--small label--underline">
          <img class="image w--2.5 h--2.5 mr--1" src="data:image/svg+xml;base64,{{ icon_project | base64_encode }}" />
          {{ todo.project }}
        </span>
        {% endif %}
        {% if todo.reminder != blank %}
        <span class="label label--small label--underline">
          <img class="image w--2 h--2 mr--0.5" src="data:image/svg+xml;base64,{{ icon_bell | base64_encode }}" />
          {{ todo.reminder }}
        </span>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>
{% endfor %}
{% endcapture -%}

{% if trmnl.plugin_settings.custom_fields_values.show_dones == "true" %}
{%- capture done_todos %}
<span class="label label--medium group-header" data-group-header="true">Finished</span>
{% for todo in dones %}
<div class="item">
  <div class="meta">
    <span class="index text--bold">✓</span>
  </div>
  <div class="content">
    <span 
      class="title title--small font--regular text--gray-25" 
      style="text-decoration: line-through; text-decoration-color: black;"
      {% if trmnl.plugin_settings.custom_fields_values.lines_title | plus: 0 > 0 %}
        data-clamp="{{ trmnl.plugin_settings.custom_fields_values.lines_title }}"
      {% endif %}
      >{{ todo.title }}</span>
    {% if todo.project != blank or todo.reminder != blank %} 
      <div class="flex flex--row">
        {% if todo.project != blank %}
        <span class="label label--small label--underline">
          <img class="image w--2.5 h--2.5 mr--1" src="data:image/svg+xml;base64,{{ icon_project | base64_encode }}" />
          {{ todo.project }}
        </span>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>
{% endfor %}
{% endcapture -%}
{% endif%}

{% assign dones_size = dones.size %}
{% assign current = dones_size | plus: 1 %}

{% if trmnl.plugin_settings.custom_fields_values.show_progress == "true" %}
{%- capture progress_dots %}
<div class="progress-dots progress-dots--small w--auto">
<div class="track flex--row-reverse">
  {% for i in (1..total) %}
    {% if i <= dones_size %}
      <div class="dot dot--filled"></div>
    {% elsif i == current %}
      <div class="dot dot--current"></div>
    {% else %}
      <div class="dot"></div>
    {% endif %}
  {% endfor %}
</div>
</div>
{% endcapture -%}
{%- capture progress_dots--small %}
<div class="progress-dots progress-dots--xsmall w--auto">
<div class="track flex--row-reverse">
  {% for i in (1..total) %}
    {% if i <= dones_size %}
      <div class="dot dot--filled"></div>
    {% elsif i == current %}
      <div class="dot dot--current"></div>
    {% else %}
      <div class="dot"></div>
    {% endif %}
  {% endfor %}
</div>
</div>
{% endcapture -%}
{%- capture progress_bar %}
    <div class="progress-bar progress-bar--xsmall progress-bar--emphasis-3 w--full w--min-40">
    <div class="track">
      <div class="fill" style="width: calc({{ dones.size }} / {{ total }} * 100%)"></div>
    </div>
  </div>
{% endcapture -%}
{% endif %}

{%- capture empty_state %}
{% if total == 0 %}
<div class="flex flex--col">
  <div class="flex flex--col gap--xsmall">
    <span class="title--large">No tasks today!</span>
    <span class="description--large font--regular">Make sure to add new tasks in Things!</span>
  </div>
</div>
{% else %}
<div class="flex flex--col">
  <img class="image w--12" src="data:image/svg+xml;base64,{{ icon_star | base64_encode }}" alt="icon">
  <div class="flex flex--col gap--xsmall">
    <span class="title--large">All done!</span>
    <span class="description--large font--regular">You've finished {{ total }} tasks today!</span>
  </div>
</div>
{% endif %}
{% endcapture -%}

{%- capture no_data-hor %}
<div class="flex gap--large flex--center">
  <div class="flex flex--col gap--xsmall flex--stretch">
    <span class="title">No data found (yet)</span>
    <span class="description--large font--regular">Get the Apple Shortcut to load your tasks into this plugin:</span>
  </div>
  {{ apple_shortcut-img }}
</div>
{% endcapture -%}
{%- capture no_data-vert %}
<div class="flex flex--col gap--large">
  <div class="flex flex--col gap--xsmall">
    <span class="title--large text--center">No data found (yet)</span>
    <span class="description--large font--regular text--center">Get the Apple Shortcut to load your tasks into this plugin:</span>
  </div>
  {{ apple_shortcut-img }}
</div>
{% endcapture -%}
