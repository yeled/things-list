<div class="layout layout--top px--6">
  <div class="columns" data-overflow-max-cols="3" data-overflow-counter="true">
    <div class="column">

      {% if todos != blank %}
        {{ regular_todos }}
      {% if dones != blank %}
        {{ done_todos }}
        {% endif %}
      {% elsif total != blank %}
        {{ empty_state }}
        {{ no_data-vert }}
      {% endif %}
    </div>
  </div>
</div>
<div class="title_bar">
  <img class="image image-stroke image-stroke--small" src="data:image/svg+xml;base64,{{ things_logo | base64_encode }}" alt="icon">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <div class="flex flex--row w--full flex--right">
  {{ progress_dots }}
  </div>
</div>
